{
  "name": "silva-diesel-controle-estoque",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "next": "16.0.0",
      "zod": "^4.1.12",
      "@trpc/server": "^11.5.0",
      "@trpc/client": "^11.5.0",
      "better-auth": "^1.3.28",
      "drizzle-orm": "^0.44.2",
      "dotenv": "^17.2.2",
      "tsdown": "^0.15.5"
    }
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check-types": "turbo check-types",
    "dev:native": "turbo -F native dev",
    "dev:web": "turbo -F web dev",
    "db:push": "turbo -F @silva-diesel-controle-estoque/db db:push",
    "db:studio": "turbo -F @silva-diesel-controle-estoque/db db:studio",
    "db:generate": "turbo -F @silva-diesel-controle-estoque/db db:generate",
    "db:migrate": "turbo -F @silva-diesel-controle-estoque/db db:migrate",
    "clear": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + && find . -name 'bun.lockb' -o -name 'bun.lock' -o -name 'package-lock.json' -o -name 'yarn.lock' -o -name 'pnpm-lock.yaml' | xargs rm -f"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "turbo": "^2.6.1",
    "tsdown": "^0.15.12",
    "@types/node": "^22.19.1"
  },
  "packageManager": "bun@1.3.2"
}
